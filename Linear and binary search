def binary_search(A, low, high, x):
 
    if high >= low:
        mid = (high + low) // 2
         # If element is present at the middle itself
        if A[mid] == x:
            return mid
         
        elif A[mid] > x:
            return binary_search(A, low, mid - 1, x)
        else:
            return binary_search(A, mid + 1, high, x)
 
    else:
        # Element is not present in the array
        return -1

